{
    "name": "qubix/qubix",
    "type": "project",
    "description": "Qubix Laravel E-Commerce",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-calendar": "*",
        "ext-curl": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-tokenizer": "*",
        "astrotomic/laravel-translatable": "^11.0.0",
        "bagisto/image-cache": "dev-master",
        "barryvdh/laravel-dompdf": "^2.0.0",
        "diglactic/laravel-breadcrumbs": "^9.0",
        "elasticsearch/elasticsearch": "^8.10",
        "enshrined/svg-sanitize": "^0.22.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "intervention/image": "^2.4",
        "kalnoy/nestedset": "^6.0",
        "khaled.alshamaa/ar-php": "^6.0.0",
        "konekt/concord": "^1.2",
        "laravel/framework": "^11.0",
        "laravel/octane": "^2.3",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.0",
        "laravel/tinker": "^2.0",
        "laravel/ui": "^4.0",
        "maatwebsite/excel": "^3.1.46",
        "mpdf/mpdf": "^8.2",
        "nesbot/carbon": "^2.72.2",
        "openai-php/laravel": "^0.10.1",
        "paypal/paypal-checkout-sdk": "1.0.1",
        "predis/predis": "^2.2",
        "prettus/l5-repository": "^2.6",
        "pusher/pusher-php-server": "^7.0",
        "shetabit/visitor": "^4.1",
        "spatie/laravel-responsecache": "^7.4",
        "spatie/laravel-sitemap": "^7.3",
        "stevebauman/purify": "^6.3"
    },
    "require-dev": {
        "bagisto/laravel-datafaker": "2.3.*",
        "barryvdh/laravel-debugbar": "^3.8",
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.1",
        "laravel/pint": "^1.19",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "DigitalLabs\\Admin\\": "packages/DigitalLabs/Admin/src",
            "DigitalLabs\\Attribute\\": "packages/DigitalLabs/Attribute/src",
            "DigitalLabs\\BookingProduct\\": "packages/DigitalLabs/BookingProduct/src",
            "DigitalLabs\\CartRule\\": "packages/DigitalLabs/CartRule/src",
            "DigitalLabs\\CatalogRule\\": "packages/DigitalLabs/CatalogRule/src",
            "DigitalLabs\\Category\\": "packages/DigitalLabs/Category/src",
            "DigitalLabs\\Checkout\\": "packages/DigitalLabs/Checkout/src",
            "DigitalLabs\\CMS\\": "packages/DigitalLabs/CMS/src",
            "DigitalLabs\\Core\\": "packages/DigitalLabs/Core/src",
            "DigitalLabs\\Customer\\": "packages/DigitalLabs/Customer/src",
            "DigitalLabs\\DataGrid\\": "packages/DigitalLabs/DataGrid/src",
            "DigitalLabs\\DataTransfer\\": "packages/DigitalLabs/DataTransfer/src",
            "DigitalLabs\\DebugBar\\": "packages/DigitalLabs/DebugBar/src",
            "DigitalLabs\\FPC\\": "packages/DigitalLabs/FPC/src",
            "DigitalLabs\\GDPR\\": "packages/DigitalLabs/GDPR/src",
            "DigitalLabs\\Installer\\": "packages/DigitalLabs/Installer/src",
            "DigitalLabs\\Inventory\\": "packages/DigitalLabs/Inventory/src",
            "DigitalLabs\\MagicAI\\": "packages/DigitalLabs/MagicAI/src",
            "DigitalLabs\\Marketing\\": "packages/DigitalLabs/Marketing/src",
            "DigitalLabs\\Notification\\": "packages/DigitalLabs/Notification/src",
            "DigitalLabs\\Paypal\\": "packages/DigitalLabs/Paypal/src",
            "DigitalLabs\\Payment\\": "packages/DigitalLabs/Payment/src",
            "DigitalLabs\\Product\\": "packages/DigitalLabs/Product/src",
            "DigitalLabs\\Rule\\": "packages/DigitalLabs/Rule/src",
            "DigitalLabs\\Sales\\": "packages/DigitalLabs/Sales/src",
            "DigitalLabs\\Shipping\\": "packages/DigitalLabs/Shipping/src",
            "DigitalLabs\\Shop\\": "packages/DigitalLabs/Shop/src",
            "DigitalLabs\\Sitemap\\": "packages/DigitalLabs/Sitemap/src",
            "DigitalLabs\\SocialLogin\\": "packages/DigitalLabs/SocialLogin/src",
            "DigitalLabs\\SocialShare\\": "packages/DigitalLabs/SocialShare/src",
            "DigitalLabs\\Tax\\": "packages/DigitalLabs/Tax/src",
            "DigitalLabs\\Theme\\": "packages/DigitalLabs/Theme/src",
            "DigitalLabs\\User\\": "packages/DigitalLabs/User/src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "DigitalLabs\\Admin\\Tests\\": "packages/DigitalLabs/Admin/tests",
            "DigitalLabs\\Core\\Tests\\": "packages/DigitalLabs/Core/tests",
            "DigitalLabs\\DataGrid\\Tests\\": "packages/DigitalLabs/DataGrid/tests",
            "DigitalLabs\\Installer\\Tests\\": "packages/DigitalLabs/Installer/tests",
            "DigitalLabs\\Shop\\Tests\\": "packages/DigitalLabs/Shop/tests"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "intervention/image",
                "laravel/socialite",
                "shetabit/visitor"
            ]
        }
    },
    "repositories": [{
        "type": "path",
        "url": "packages/*/*",
        "options": {
            "symlink": true
        }
    }],
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/qubix/qubix/issues",
        "forum": "https://forums.qubix.com",
        "source": "https://github.com/qubix/qubix",
        "docs": "https://devdocs.qubix.com"
    }
}
