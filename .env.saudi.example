# Qubix — Saudi Arabia storefront env template (docker-compose.sa.yml, VPS /opt/qubix-sa).
# Copy to `.env` on the server and fill in the placeholders. NEVER commit the real .env.
# Service hostnames are the Docker service names from docker-compose.sa.yml.
#
# Replace every <SAUDI_DOMAIN> below before using this file.

APP_NAME="JJ Bags"
APP_ENV=production
# Generate a FRESH key on this install, before importing any data — this is a
# separate database, not a decrypt-in-place of India's encrypted columns.
APP_KEY=
APP_DEBUG=false
APP_DEBUG_ALLOWED_IPS=
APP_URL=https://<SAUDI_DOMAIN>
APP_ADMIN_URL=admin
APP_TIMEZONE=Asia/Riyadh

# Admin panel language only. The Arabic STOREFRONT comes from the channel's
# default_locale (set by scripts/convert-to-saudi.sql), not from here — the
# admin panel has no locale middleware and follows APP_LOCALE globally.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_CURRENCY=SAR
APP_MAINTENANCE_DRIVER=file

# --- Logging ---
LOG_LEVEL=warning

# --- Database (service name `mysql` on the qubix-sa network) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=qubix_sa
DB_USERNAME=qubix_sa
DB_PASSWORD=__SET_A_NEW_STRONG_PASSWORD__
DB_PREFIX=

# --- Sessions / cache / queue -> Redis in production ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=

# --- Redis (service name `redis`) — password-protected, unlike India's ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=__SET_A_NEW_STRONG_PASSWORD__
REDIS_PORT=6379

# --- Elasticsearch (service name `elasticsearch`) ---
ELASTICSEARCH_HOST=http://elasticsearch:9200
ELASTICSEARCH_USER=
ELASTICSEARCH_PASS=

# --- Mail ---
# Default to `log` (no real email) until real SMTP credentials are provided.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=shop@<SAUDI_DOMAIN>
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_MAIL_ADDRESS=admin@<SAUDI_DOMAIN>
ADMIN_MAIL_NAME=Admin

CONTACT_MAIL_ADDRESS=contact@<SAUDI_DOMAIN>
CONTACT_MAIL_NAME="JJ Bags"

# --- Assets: production serves BUILT assets, never the Vite dev server ---
SAIL_VITE_SHOP=false
SHOP_HOME_LAYOUT=legacy
