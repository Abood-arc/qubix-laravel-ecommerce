# Qubix fleet stack: MySQL tuning for a small per-client instance.
#
# This is a full replacement of the image's /etc/my.cnf (mysql/mysql-server:8.0,
# Oracle's official image). There is no /etc/mysql/ directory and no
# `!includedir` directive in this image (verified 2026-09-16 — `mysqld --verbose
# --help`'s compiled-in config search order is
# `/etc/my.cnf /etc/mysql/my.cnf /usr/etc/my.cnf ~/.my.cnf`, and only /etc/my.cnf
# exists), so mounting a fragment into an include directory isn't possible here;
# this file is bind-mounted directly over /etc/my.cnf instead. Every directive
# from the original shipped file is preserved below (see docker-compose.yml's
# mysql service and Task 2.2's report for the original content this replaces).
#
# For advice on how to change settings please see
# http://dev.mysql.com/doc/refman/8.0/en/server-configuration-defaults.html

[mysqld]
skip-host-cache
skip-name-resolve
datadir=/var/lib/mysql
socket=/var/lib/mysql/mysql.sock
secure-file-priv=/var/lib/mysql-files
user=mysql

pid-file=/var/run/mysqld/mysqld.pid

#
# --- Qubix fleet tuning (Task 2.2) ---
#
# Sized for a single small client's schema (131 tables, ~5MB of data measured
# 2026-09-16 on the local `qubix` database) rather than MySQL's stock defaults,
# which assume a much larger, unknown workload. Goal: fit ~18-20 of these
# per-client MySQL instances on one fleet host instead of one per box.

# performance_schema defaults to ON and instruments every statement/wait/stage
# by pre-allocating a large set of fixed-size in-memory tables at startup —
# this is most of the stock ~250-500MB RSS on a schema this small, and it buys
# nothing we're using (no P_S-based monitoring wired up anywhere in this repo).
performance_schema=OFF

# Stock default is 128M, sized for "10% of RAM on a shared box, 70% on a
# dedicated one." The whole `qubix` database is ~5MB; 64M comfortably holds
# the entire working set with room to grow before a client's catalog gets
# large, without reserving memory that mostly just sits idle.
innodb_buffer_pool_size=64M

# Stock default is 4000, clearly sized for a much larger schema than this
# app's. The `qubix` schema has 131 tables total (measured via
# information_schema.tables, 2026-09-16). table_open_cache holds open table
# handles, shared across concurrent sessions, not allocated per-connection —
# it doesn't need to cover every table for every connection at once. Sized at
# roughly max_connections (30) x an ~10-table join/session ceiling admin
# reports realistically hit, rounded up, while staying well under the number
# of file descriptors 4000 would reserve for a schema this small.
table_open_cache=300

# Stock default is 16M, matching max_heap_table_size (MySQL uses the smaller
# of the two as the actual in-memory cap, so they're kept equal). Left at the
# default rather than shrunk further: it's allocated on demand per query, not
# reserved at startup, so it doesn't move the idle RSS figure this task is
# actually tuning for, and this schema's admin DataGrid reports already do
# nontrivial sorting/filtering — shrinking it would trade a memory saving that
# doesn't show up at idle for more temp tables spilling to disk on real pages.
tmp_table_size=16M
max_heap_table_size=16M

# PHP-FPM (docker/php/fpm-pool.conf) runs `pm = static`, `pm.max_children = 8`
# — at most 8 concurrent DB connections from web requests. Add headroom for a
# queue worker (1), the scheduler (1, mostly idle but connects), and
# artisan/tinker/CLI usage running alongside a live site (a handful more), and
# 151 (the stock default, sized for a generic multi-tenant MySQL server) is
# far more than this single-app instance will ever open. 30 gives roughly 2x
# the ~15 connections realistically expected at once, without leaving the
# door open to an unbounded connection storm exhausting memory
# (each connection has its own per-thread buffers on top of the shared pool).
max_connections=30
