# Qubix — PRODUCTION env template for the Hostinger VPS (jjbags.in).
# Copy to `.env` on the server and fill in the placeholders. NEVER commit the real .env.
# Service hostnames are the Docker service names from docker-compose.prod.yml.

APP_NAME=Qubix
APP_ENV=production
# Reuse the APP_KEY from the source environment (the Azure VM) so encrypted DB values still
# decrypt. Do NOT run key:generate on an imported database.
APP_KEY=
APP_DEBUG=false
APP_DEBUG_ALLOWED_IPS=
APP_URL=https://jjbags.in
APP_ADMIN_URL=admin
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_CURRENCY=USD
APP_MAINTENANCE_DRIVER=file

# --- Logging ---
# Without this, production silently inherits the `debug` default (config/logging.php),
# which is far noisier than a live site needs.
LOG_LEVEL=warning

# --- Database (service name `mysql` on the qubix network) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=qubix
DB_USERNAME=qubix
DB_PASSWORD=__SET_A_STRONG_PASSWORD__
DB_PREFIX=

# --- Sessions / cache / queue -> Redis in production ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=

# --- Redis (service name `redis`) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Elasticsearch (service name `elasticsearch`) ---
ELASTICSEARCH_HOST=http://elasticsearch:9200
ELASTICSEARCH_USER=
ELASTICSEARCH_PASS=

# --- Mail ---
# Default to `log` (no real email) until real SMTP credentials are provided.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=shop@jjbags.in
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_MAIL_ADDRESS=admin@jjbags.in
ADMIN_MAIL_NAME=Admin

CONTACT_MAIL_ADDRESS=contact@jjbags.in
CONTACT_MAIL_NAME="JJ Bags"

# --- Assets: production serves BUILT assets, never the Vite dev server ---
SAIL_VITE_SHOP=false
